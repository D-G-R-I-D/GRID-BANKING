# Copy to .env.local and fill in. NEVER commit real values.
# Anything the browser may see MUST be safe to make public — do not put
# secrets behind a NEXT_PUBLIC_ prefix.

# --- Public (safe for the browser) ---------------------------------------
NEXT_PUBLIC_APP_ENV=development           # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only (BFF) --------------------------------------------------
# Upstream Spring Boot API — reached only by the BFF, never the browser.
GRID_API_BASE_URL=http://localhost:8080

# Session encryption key for the BFF session store (32+ random bytes, base64).
SESSION_SECRET=

# Session store connection (in-memory if unset during early dev).
REDIS_URL=

# WebAuthn / passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=GRID Banking
WEBAUTHN_ORIGIN=http://localhost:3000

# Bot protection (Cloudflare Turnstile) — server verifies the token.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Error reporting (optional in dev)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
