# Copy to .env and fill in. Never commit real secrets.

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://grid:grid@localhost:5433/grid?schema=public"

# Session cookie encryption. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be at least 32 characters.
SESSION_SECRET="dev-only-change-me-to-32+-random-characters"

# Public base URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
